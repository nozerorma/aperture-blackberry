<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bbModeGridContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#D91E1E1E"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp"
    android:visibility="gone">

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alignmentMode="alignMargins"
        android:columnCount="3"
        android:rowCount="2"
        android:useDefaultMargins="true">

        <!-- Mode Photo -->
        <LinearLayout
            android:id="@+id/modeItemPhoto"
            android:layout_width="88dp"
            android:layout_height="76dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivModeIconPhoto"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bb_mode_icon_bg"
                android:padding="10dp"
                android:src="@drawable/ic_mode_photo" />

            <TextView
                android:id="@+id/tvModeTitlePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/bb_mode_photo"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Mode Video -->
        <LinearLayout
            android:id="@+id/modeItemVideo"
            android:layout_width="88dp"
            android:layout_height="76dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivModeIconVideo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bb_mode_icon_bg"
                android:padding="10dp"
                android:src="@drawable/ic_mode_video" />

            <TextView
                android:id="@+id/tvModeTitleVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/bb_mode_video"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Mode Pro / Manual -->
        <LinearLayout
            android:id="@+id/modeItemPro"
            android:layout_width="88dp"
            android:layout_height="76dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivModeIconPro"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bb_mode_icon_bg"
                android:padding="10dp"
                android:src="@drawable/ic_mode_pro" />

            <TextView
                android:id="@+id/tvModeTitlePro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/bb_mode_pro"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Mode Portrait -->
        <LinearLayout
            android:id="@+id/modeItemPortrait"
            android:layout_width="88dp"
            android:layout_height="76dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivModeIconPortrait"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bb_mode_icon_bg"
                android:padding="10dp"
                android:src="@drawable/ic_mode_portrait" />

            <TextView
                android:id="@+id/tvModeTitlePortrait"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/bb_mode_portrait"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Mode Panorama -->
        <LinearLayout
            android:id="@+id/modeItemPanorama"
            android:layout_width="88dp"
            android:layout_height="76dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivModeIconPanorama"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bb_mode_icon_bg"
                android:padding="10dp"
                android:src="@drawable/ic_mode_pano" />

            <TextView
                android:id="@+id/tvModeTitlePanorama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/bb_mode_pano"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </GridLayout>

</LinearLayout>
