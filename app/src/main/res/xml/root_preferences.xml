<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/general_header">

        <SwitchPreference
            app:defaultValue="false"
            app:icon="@drawable/ic_brightness_high"
            app:key="bright_screen"
            app:summary="@string/bright_screen_summary"
            app:title="@string/bright_screen_title" />

        <SwitchPreference
            app:defaultValue="false"
            app:icon="@drawable/ic_location_on"
            app:key="save_location"
            app:summary="@string/save_location_summary"
            app:title="@string/save_location_title" />

        <SwitchPreference
            app:defaultValue="true"
            app:icon="@drawable/ic_volume_up"
            app:key="shutter_sound"
            app:summary="@string/shutter_sound_summary"
            app:title="@string/shutter_sound_title" />

        <SwitchPreference
            app:defaultValue="false"
            app:icon="@drawable/ic_screen_rotation"
            app:key="leveler"
            app:summary="@string/leveler_summary"
            app:title="@string/leveler_title" />

        <SwitchPreference
            app:defaultValue="true"
            app:icon="@drawable/ic_touch_app"
            app:key="split_touch_scroll"
            app:summary="@string/split_touch_scroll_summary"
            app:title="@string/split_touch_scroll_title" />

        <Preference
            app:fragment="org.lineageos.aperture.SettingsActivity$GesturesSettingsFragment"
            app:icon="@drawable/ic_touch_app"
            app:title="@string/gestures_title" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/remember_header">

        <SwitchPreference
            app:defaultValue="true"
            app:icon="@drawable/ic_tune"
            app:key="remember_settings"
            app:summary="@string/remember_settings_summary"
            app:title="@string/remember_settings_title" />

        <SwitchPreference
            app:defaultValue="true"
            app:icon="@drawable/ic_image"
            app:key="remember_format_resolution_capture_mode"
            app:summary="@string/remember_format_resolution_capture_mode_summary"
            app:title="@string/remember_format_resolution_capture_mode_title" />

        <SwitchPreference
            app:defaultValue="true"
            app:icon="@drawable/ic_hdr_on"
            app:key="remember_hdr"
            app:summary="@string/remember_hdr_summary"
            app:title="@string/remember_hdr_title" />

        <SwitchPreference
            app:defaultValue="true"
            app:icon="@drawable/ic_grid_3x3"
            app:key="remember_grid_stabilization"
            app:summary="@string/remember_grid_stabilization_summary"
            app:title="@string/remember_grid_stabilization_title" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/photos_header">

        <ListPreference
            app:defaultValue="minimize_latency"
            app:entries="@array/photo_capture_mode_entries"
            app:entryValues="@array/photo_capture_mode_values"
            app:icon="@drawable/ic_image"
            app:key="photo_capture_mode"
            app:title="@string/photo_capture_mode_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreference
            app:defaultValue="false"
            app:icon="@drawable/ic_shutter_base"
            app:key="enable_zsl"
            app:summary="@string/enable_zsl_summary"
            app:title="@string/enable_zsl_title" />

        <SwitchPreference
            app:defaultValue="true"
            app:icon="@drawable/ic_hdr_on"
            app:key="use_photo_jpeg_ultra_hdr"
            app:summary="@string/use_photo_jpeg_ultra_hdr_summary"
            app:title="@string/use_photo_jpeg_ultra_hdr_title" />

        <SwitchPreference
            app:defaultValue="false"
            app:icon="@drawable/ic_raw_on"
            app:key="enable_raw_image_capture"
            app:summary="@string/enable_raw_image_capture_summary"
            app:title="@string/enable_raw_image_capture_title" />

        <SwitchPreference
            app:defaultValue="false"
            app:dependency="enable_raw_image_capture"
            app:icon="@drawable/ic_broken_image"
            app:key="disable_jpeg_with_raw"
            app:summary="@string/disable_jpeg_with_raw_summary"
            app:title="@string/disable_jpeg_with_raw_title" />

        <SwitchPreference
            app:defaultValue="true"
            app:icon="@drawable/ic_flip_camera"
            app:key="photo_ffc_mirror"
            app:summary="@string/photo_ffc_mirror_summary"
            app:title="@string/photo_ffc_mirror_title" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/video_header">

        <SwitchPreference
            app:defaultValue="true"
            app:icon="@drawable/ic_video_frame_rate"
            app:key="video_stabilization"
            app:summary="@string/video_stabilization_summary"
            app:title="@string/video_stabilization_title" />

        <ListPreference
            app:defaultValue="off"
            app:entries="@array/video_mirror_mode_entries"
            app:entryValues="@array/video_mirror_mode_values"
            app:icon="@drawable/ic_flip_camera"
            app:key="video_mirror_mode"
            app:title="@string/video_mirror_mode_title"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/advanced_header">

        <Preference
            app:fragment="org.lineageos.aperture.SettingsActivity$ProcessingSettingsFragment"
            app:icon="@drawable/ic_tune"
            app:title="@string/processing_title" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/bb_about_header">

        <Preference
            app:icon="@drawable/ic_system_update"
            app:key="check_updates"
            app:summary="@string/bb_check_updates_summary"
            app:title="@string/bb_check_updates_title" />

    </PreferenceCategory>

</PreferenceScreen>
